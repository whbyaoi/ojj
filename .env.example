# 当前程序显式读取的全部 36 个环境变量；按用途分组，注释标明程序默认值。
# 本示例保留心跳 30m、历史消息 50 条的配置，其他项按下述默认值填写。
# 复制为 .env，填入凭据后在此目录运行 go run ./cmd/ojj；所有配置修改后均需重启。
# 已存在的进程环境变量优先于本文件（包括空值）；本文件不覆盖启动环境。
# 必填项不能留空；其余项留空或省略使用下述默认值，条件项仅在对应功能启用时读取。
# .env 已被 Git 忽略；不要提交或分享真实密钥，建议权限 chmod 600 .env。
# 值含空格、# 或 $ 时建议用单引号包裹；这里不是 shell 脚本。

# ── 1. QQ 机器人凭据（必填，无默认值）──
QQ_APP_ID=
QQ_CLIENT_SECRET=

# ── 2. 模型协议与凭据 ──
# 默认 openai；仅支持 openai / anthropic，不自动重试或切换协议。
# 只读取所选协议的配置，不会把一种协议的凭据自动用于另一种协议。
OJJ_MODEL_PROTOCOL=openai
# openai 协议必填 API_KEY 与 MODEL，无默认值；使用非流式 Chat Completions。
OPENAI_API_KEY=
OPENAI_MODEL=
# 默认 https://api.openai.com；可填服务根地址或以 /v1 结尾的前缀，不含 /chat/completions。
OPENAI_BASE_URL=https://api.openai.com
# 默认 max_tokens；仅支持 max_tokens / max_completion_tokens，只发送选中的字段。
OPENAI_TOKEN_LIMIT_FIELD=max_tokens
# anthropic 协议必填 API_KEY 与 MODEL，无默认值；使用时将上方协议改为 anthropic。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 默认 https://api.anthropic.com；可填服务根地址或以 /v1 结尾的前缀，不含 /messages。
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── 3. 人格 ──
# 默认进程工作目录下的 portrait.md；可指定绝对路径，相对路径按进程工作目录解析。
# 必须是非空 UTF-8 普通文件且不超过 64 KiB；缺失或无效时在开库前停止启动。
# 与宿主规则拼接后供所选协议使用；人格不授予发送权限或新增工具能力。
OJJ_PORTRAIT_FILE=portrait.md

# ── 4. QQ 发送白名单 ──
# 默认空：不额外限制私聊/群聊收件人，但仍受宿主回复策略和 QQ 平台权限、配额限制。
# 非空仅允许名单内目标；逗号分隔，禁止通配符，填写实际 OpenID，不是 QQ 号或群号。
# 示例格式：private:USER_OPENID,group:GROUP_OPENID
OJJ_QQ_SEND_ALLOWLIST=

# ── 5. 群聊回复许可与主动回复 ──
# 普通群消息与自然续聊均可成为回复候选，由模型结合上下文判断是否值得回复，不要求固定句式。
# 候选不代表必须发送，仍受白名单、可信当前输入、时效、额度和防重限制；心跳和人设不扩权。
# 默认空：不按用户 ID 匹配提及/引用；应填事件中的机器人用户 ID，不是 QQ_APP_ID。
# GROUP_AT_MESSAGE_CREATE 类型本身也可触发，不依赖此字段。
OJJ_REPLY_BOT_USER_ID=
# 默认空：无别名。逗号分隔，去每项首尾空白，不允许空项；最多 32 项，每项最多 128 字节。
# 全文等于别名，或别名前缀后紧接空格、逗号、冒号、感叹号、问号、顿号时可触发。
OJJ_REPLY_ALIASES=
# 兼容旧配置与数据库迁移的布尔字段，默认 false；仍解析校验并参与配置代际判定。
# 不再控制普通群消息是否成为候选，设为 false 也可由模型选择回复；不是所有消息都回复。
OJJ_REPLY_PROACTIVE=false
# 每群普通消息回复（包括自然续聊）的最小预留间隔，默认 90s；明确触发只计总额度。
OJJ_REPLY_ACTIVE_INTERVAL=90s
# 每群主动回复额度统计窗口，默认 10m，不得短于主动间隔。
OJJ_REPLY_ACTIVE_WINDOW=10m
# 每群主动回复在上述窗口内最多预留的发送次数，默认 3。
OJJ_REPLY_ACTIVE_LIMIT=3
# 兼容旧会话记录与数据库迁移的时长字段，默认 2m；仍校验并参与配置代际判定。
# 不再用会话有效期或固定续聊词限制候选；普通续聊适用上述主动额度及总额度。
OJJ_REPLY_SESSION_TTL=2m
# 每群所有回复共用的额度统计窗口（包括明确触发、续接、主动），默认 1m；私聊不计群额度。
OJJ_REPLY_TOTAL_WINDOW=1m
# 每群在总窗口内最多预留的发送次数，默认 12。
OJJ_REPLY_TOTAL_LIMIT=12
# 以上时长必须为正（如 90s、2m），额度必须为正整数；额度在发送前占用，失败/未知也不释放。
# 当前输入原消息最多尝试发送一次；跳过不是错误，不排队、不重试、不换序号或目标补发。
# 原消息发生与接收时间均有固定 2 分钟时效限制，无环境变量可调整。
# 配置代际切换保留额度与幂等记录，但清除续接会话；账号及 BotUserID 不可原地更换。
# legacy v1/v2 数据库必须先停旧程序，按原配置完成迁移后再调整配置。
# 永久预占上限 100 万条、actor 上限 10 万个，达到上限拒绝发送，不自动清除记录。
# 已进入发送过程的在途请求不能撤回。

# ── 6. 脚本工具 ──
# 默认 false；仅支持 Linux/macOS，启用后可访问宿主文件和网络，不是沙箱。
OJJ_ENABLE_COMMAND=false
# 仅启用脚本时读取；默认进程当前目录，目录必须存在。这是起始目录，不是访问边界。
# 留空使用默认目录；需要时填 /absolute/path/to/workdir。
OJJ_COMMAND_DIR=

# ── 7. 日志 ──
# 输出到 stderr；不记录消息正文、密钥、工具参数/结果及原始错误。
# 默认 INFO；支持 DEBUG / INFO / WARN / ERROR，发送跳过诊断需至少保留 INFO。
OJJ_LOG_LEVEL=INFO
# 默认 text；支持 text / json。
OJJ_LOG_FORMAT=text

# ── 8. 持久化路径 ──
# 路径相对于进程工作目录，数据库父目录须预先存在；不要通过换库绕过额度或幂等保护。
# 事件库默认 events.db；图片缓存目录固定为该路径加 .images，没有独立环境变量。
OJJ_EVENT_DB=events.db
# 默认事件库路径加 .messages.db；留空保持随事件库路径派生，通常是 events.db.messages.db。
OJJ_MESSAGE_DB=
# 默认事件库路径加 .brain.main.db；留空保持派生，通常是 events.db.brain.main.db。
OJJ_BRAIN_DB=
# 默认事件库路径加 .reply.db；留空保持派生，通常是 events.db.reply.db。
# 回复策略库必须使用普通文件路径，拒绝 :memory: 和 file: URI。
OJJ_REPLY_DB=

# ── 9. 心跳与消息聚合 ──
# 心跳周期默认 5m，必须为正时长；心跳事件本身不授予 QQ 发送权限。
OJJ_HEARTBEAT_INTERVAL=30m
# 消息窗口静默封窗等待时间，默认 8s，必须为正时长。
OJJ_MESSAGE_QUIET_PERIOD=8s
# 消息窗口最长持续时间，默认 30s，必须为正时长。
OJJ_MESSAGE_MAX_WINDOW=30s

# ── 10. 主决策脑区容量 ──
# 单次输入字节上限，默认 16 MiB；必须为正整数，超限拒绝接收且不确认上游。
OJJ_BRAIN_MAX_INPUT_BYTES=16777216
# 上下文字节上限，默认 64 MiB，必须为正整数；不是模型的 token 上限。
OJJ_BRAIN_MAX_CONTEXT_BYTES=67108864
# 开始处理时最多加载的消息条数（含当前输入），默认 1000，必须为正整数。
# 保留最近完整任务，实际可少于上限；不删除记录，不截断本轮新生成的消息，字节上限仍生效。
OJJ_BRAIN_MAX_HISTORY_MESSAGES=50
# 逻辑存储字节上限，默认 1 GiB，必须为正整数；不是数据库文件物理大小，不自动淘汰记录。
OJJ_BRAIN_MAX_STORED_BYTES=1073741824